# Runtime environment
NODE_ENV=development

# --- Threat Intelligence Providers (optional) ---
# When a key is left empty, SentinelScope reports that provider as
# "unavailable" rather than fabricating a result. See README > Limitations.

# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# --- Rate limiting ---
# Requests allowed per IP per window for POST /api/analyze
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# --- Cache ---
# How long a completed analysis is served from cache before re-running
ANALYSIS_CACHE_TTL_MS=300000

# --- Logging ---
# Minimum server log level: debug | info | warn | error | silent
LOG_LEVEL=info

# --- Persistent store (required on serverless platforms, e.g. Vercel) ---
# Without these, SentinelScope falls back to a local JSON file under
# ./data — fine for local dev, Docker, or a VPS, but each serverless
# invocation gets its own stateless filesystem, so /analysis/[id] pages and
# rate limiting would not work reliably there without Redis.
# Create a free database at https://console.upstash.com/redis and copy its
# REST URL/token (Vercel's Upstash integration injects the same values
# under KV_REST_API_URL / KV_REST_API_TOKEN automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
