{
  "name": "sentinelscope",
  "version": "1.1.0",
  "private": true,
  "description": "Passive security posture scanner for websites, domains and IPs: DNS, TLS, HTTP security headers, domain and IP intelligence, and threat reputation, combined into one explainable risk score.",
  "keywords": [
    "security",
    "security-scanner",
    "threat-intelligence",
    "osint",
    "passive-reconnaissance",
    "tls",
    "dns",
    "http-security-headers",
    "ssrf-protection",
    "risk-score",
    "nextjs",
    "typescript"
  ],
  "homepage": "https://sentinelscope-nu.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmet-yuksell/sentinelscope-security.git"
  },
  "bugs": {
    "url": "https://github.com/mehmet-yuksell/sentinelscope-security/issues"
  },
  "author": {
    "name": "Mehmet Yüksel",
    "url": "https://github.com/mehmet-yuksell"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@upstash/redis": "1.38.4",
    "next": "16.4.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.1",
    "tldts": "7.4.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
